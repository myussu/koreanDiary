<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad (Android 12+): diarios (base de datos), workbook, conversaciones, explicaciones de sugerencias, mascota y ajustes.
  Se excluyen las claves de API: están cifradas con una llave del Keystore que no viaja a otro
  dispositivo, así que no servirían; se vuelven a escribir en Ajustes.

  Las fotos del workbook (workbook_photos/), el audio de las escuchas (listen_audio/) y las imágenes
  de las escenas (scene_images/) no van a la nube: Google guarda como mucho 25 MB por app y, si se
  pasa, no guarda nada. Sí viajan al pasar de
  un celular a otro, que no tiene ese límite, y en la copia que se exporta a un archivo desde Ajustes.

  Las rutas no admiten comodines: por eso las fotos tienen su propia carpeta. Lo que no está
  incluido aquí no se copia (restore/, backups/ y backup_state.xml son de este celular).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="workbook/" />
        <include domain="file" path="explanations/" />
        <include domain="file" path="conversation/" />
        <include domain="file" path="mascot/" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="workbook/" />
        <include domain="file" path="workbook_photos/" />
        <include domain="file" path="listen_audio/" />
        <include domain="file" path="scene_images/" />
        <include domain="file" path="explanations/" />
        <include domain="file" path="conversation/" />
        <include domain="file" path="mascot/" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
