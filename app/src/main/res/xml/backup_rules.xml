<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad (Android 11 o anterior): las mismas reglas de la nube de data_extraction_rules.xml.
  Este formato no separa la nube del paso entre celulares, así que aquí las fotos del workbook
  (workbook_photos/), el audio de las escuchas (listen_audio/) y las imágenes de las escenas
  (scene_images/) no viajan de ninguna de las dos formas; van en la copia exportada a un archivo.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="workbook/" />
    <include domain="file" path="explanations/" />
    <include domain="file" path="conversation/" />
    <include domain="file" path="mascot/" />
    <include domain="sharedpref" path="settings.xml" />
</full-backup-content>
